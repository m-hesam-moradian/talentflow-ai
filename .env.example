# ==============================================================================
# TalentFlow-AI Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Primary LLM Configuration (OpenAI-compatible: Dahl / DeepSeek / MiniMax / etc.)
# ------------------------------------------------------------------------------
PRIMARY_LLM_API_KEY="your_primary_llm_api_key_here"
PRIMARY_LLM_BASE_URL="https://api.deepseek.com/v1"
PRIMARY_LLM_MODEL="deepseek-chat"

# ------------------------------------------------------------------------------
# Fallback LLM Configuration (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini/gemini-2.5-flash"

# ------------------------------------------------------------------------------
# Observability & Tracing (Langfuse)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY="pk-lf-xxxxxxxx"
LANGFUSE_SECRET_KEY="sk-lf-xxxxxxxx"
LANGFUSE_HOST="https://cloud.langfuse.com"

# ------------------------------------------------------------------------------
# Storage & Sync (Google Sheets)
# ------------------------------------------------------------------------------
# The ID of your target Google Sheet (extracted from sheet URL)
GOOGLE_SHEET_ID="your_google_sheet_id_here"
# Raw JSON string or path to Google Service Account credentials JSON file
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "talentflow-agent"}'

# ------------------------------------------------------------------------------
# GitHub Actions Automation & Priority Webhooks
# ------------------------------------------------------------------------------
GITHUB_PAT_TOKEN="ghp_your_github_personal_access_token"
GITHUB_REPOSITORY="username/talentflow-ai"

# ------------------------------------------------------------------------------
# Application Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT="development"
DRY_RUN=true
HEADLESS=true
MAX_JOBS_PER_RUN=10
LOG_LEVEL="INFO"
